# Example environment variables for the Chaum-Pedersen server.
# Copy this file to `.env`; it is loaded automatically when the server starts.
#
# Precedence (highest to lowest):
# 1. CLI flags (e.g. `--port 8080`)
# 2. Environment variables set in your shell
# 3. This `.env` file
# 4. Built-in defaults
#
# Every variable below has an equivalent CLI flag; run `server --help` for details.

# Server network settings
SERVER_HOST=127.0.0.1
SERVER_PORT=50051

# Rate limiting (per-peer token bucket)
SERVER_RATE_LIMIT_RPM=100
SERVER_RATE_LIMIT_BURST=50

# Prometheus metrics (disabled by default)
SERVER_METRICS_ENABLED=false
SERVER_METRICS_PORT=9090
